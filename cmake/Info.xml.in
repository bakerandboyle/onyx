<?xml version="1.0" encoding="UTF-8"?>
<!--
  OnYX OFX Plugin Bundle Information
  Generated by CMake from Info.xml.in
-->
<openfxPlugin>
    <id>com.bakerandboyle.onyx</id>
    <version>
        <major>@PROJECT_VERSION_MAJOR@</major>
        <minor>@PROJECT_VERSION_MINOR@</minor>
        <patch>@PROJECT_VERSION_PATCH@</patch>
    </version>
    <apiVersion>1.4</apiVersion>
    <label>OnYX Video Stabilisation</label>
    <group>Transform</group>
    <description>
        GPU-accelerated video stabilisation using spectral phase correlation.
        Provides 3DOF stabilisation (X, Y, Roll) with adaptive smoothing.
    </description>
    <vendor>Baker &amp; Boyle Research</vendor>
    <vendorURL>https://bakerandboyle.com/onyx</vendorURL>
    <copyright>Copyright (c) 2026 Baker &amp; Boyle Research</copyright>
    
    <buildInfo>
        <gitHash>@ONYX_GIT_HASH@</gitHash>
        <gitDescribe>@ONYX_GIT_DESCRIBE@</gitDescribe>
        <buildDate>@ONYX_BUILD_DATE@</buildDate>
        <buildType>@CMAKE_BUILD_TYPE@</buildType>
    </buildInfo>
</openfxPlugin>
